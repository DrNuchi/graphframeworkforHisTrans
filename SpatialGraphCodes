## ---- graph builders --------------------------------------------------------
build_graph <- function(co, type=GRAPH_TYPE, k=K, radius=RADIUS_UM){
  n <- nrow(co)
  if (type == "knn"){
    knn <- FNN::get.knn(co, k=k)
    ei  <- rep(seq_len(n), each=k)
    ej  <- as.vector(t(knn$nn.index))
    w   <- as.vector(t(knn$nn.dist))
    g   <- igraph::graph_from_edgelist(cbind(ei,ej), directed=FALSE)
    igraph::E(g)$weight <- w
    g   <- igraph::simplify(g, edge.attr.comb="first")
    
  } else if (type == "radius"){
    # neighbours within radius: over-fetch kNN, then keep pairs within radius.
    kk  <- min(n - 1, 50)
    knn <- FNN::get.knn(co, k = kk)
    within <- knn$nn.dist <= radius            # logical matrix, n x kk
    # guard: if any nucleus has ALL kk fetched neighbours within radius, its
    # true degree may exceed kk and be truncated. Warn so it's never silent.
    if (any(rowSums(within) == kk) && kk < (n - 1))
      warning(sprintf("radius graph: %d nuclei may exceed the k=%d neighbour cap at r=%g; increase kk.",
                      sum(rowSums(within) == kk), kk, radius))
    src <- row(within)[within]                 # source node index
    nbr <- knn$nn.index[within]                # neighbour node index (aligned)
    w   <- knn$nn.dist[within]                 # edge length
    # build on a FIXED vertex set of size n so isolated nuclei are retained
    g   <- igraph::make_empty_graph(n = n, directed = FALSE)
    if (length(src)) {
      g <- igraph::add_edges(g, rbind(src, nbr), weight = w)
      g <- igraph::simplify(g, edge.attr.comb = "first")  # drops duplicate i-j / j-i
    }
    
  } else if (type == "delaunay"){
    dd  <- deldir::deldir(co[,1], co[,2], suppressMsge=TRUE)
    el  <- as.matrix(dd$delsgs[, c("ind1","ind2")])
    len <- sqrt((co[el[,1],1]-co[el[,2],1])^2 + (co[el[,1],2]-co[el[,2],2])^2)
    keep <- len <= MAX_EDGE_UM               # prune void-bridging edges
    el   <- el[keep, , drop=FALSE]; len <- len[keep]
    # build on a FIXED vertex set of size n so pruning-isolated nuclei survive
    g   <- igraph::make_empty_graph(n = n, directed = FALSE)
    if (nrow(el)) {
      g <- igraph::add_edges(g, as.vector(t(el)), weight = len)
      g <- igraph::simplify(g, edge.attr.comb = "first")
    }
  } else stop("Unknown GRAPH_TYPE")
  
  igraph::V(g)$x <- co[,1]; igraph::V(g)$y <- co[,2]
  g
}

## ---- per-image graph metrics ----------------------------------------------
graph_metrics <- function(df){
  co <- as.matrix(df[,.(x,y)])
  g  <- build_graph(co)
  deg <- igraph::degree(g)
  comp <- igraph::components(g)
  
  # --- density & nearest-neighbour distance (independent of graph choice) ---
  # tissue area from the convex hull (µm^2 -> mm^2); hull hugs irregular tissue
  # far better than a bounding box.
  hull_area_mm2 <- tryCatch({
    ch <- grDevices::chull(co); poly <- co[c(ch, ch[1]), ]
    abs(sum(poly[-nrow(poly),1]*poly[-1,2] - poly[-1,1]*poly[-nrow(poly),2]))/2/1e6
  }, error=function(e) NA_real_)
  # nearest-neighbour distance via FNN (k=1)
  nnd <- FNN::get.knn(co, k=1)$nn.dist[,1]
  
  data.table(
    file           = df$file[1],
    condition      = df$condition[1],
    replicate      = df$replicate[1],
    n_nodes        = igraph::vcount(g),
    n_edges        = igraph::ecount(g),
    density_per_mm2 = nrow(co) / hull_area_mm2,
    mean_nnd_um    = mean(nnd),
    mean_degree    = mean(deg),
    sd_degree      = sd(deg),
    graph_density  = igraph::edge_density(g),
    transitivity   = igraph::transitivity(g, type="global"),  # clustering coeff
    mean_local_cc  = mean(igraph::transitivity(g, type="local"), na.rm=TRUE),
    mean_edge_len  = mean(igraph::E(g)$weight),
    assortativity  = suppressWarnings(igraph::assortativity_degree(g)),
    n_components   = comp$no,
    frac_largest   = max(comp$csize)/igraph::vcount(g),
    mean_path_len  = tryCatch(igraph::mean_distance(g, directed=FALSE),
                              error=function(e) NA_real_)
  )
}

