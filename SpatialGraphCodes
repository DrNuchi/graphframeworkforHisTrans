## ---- distance-to-baseline (Day 0) analysis ---------------------------------
# Does metformin move tissue toward or away from the Day 0 baseline?
# Metrics are z-scored across images so they are comparable, then each
# condition's centroid distance to the Day 0 centroid is computed.
baseline <- "Day 0"
dist_metrics <- c("density_per_mm2","mean_nnd_um","mean_degree","transitivity")

Z <- copy(gm)
for (m in dist_metrics)
  Z[[m]] <- (gm[[m]] - mean(gm[[m]], na.rm=TRUE)) / sd(gm[[m]], na.rm=TRUE)
cen <- Z[, lapply(.SD, mean, na.rm=TRUE), by=condition, .SDcols=dist_metrics]
# unlist() coerces the 1-row data.table to a plain numeric vector.
# (as.numeric() on a data.table errors: "(list) object cannot be coerced".)
base_vec <- unlist(cen[condition==baseline, ..dist_metrics], use.names=FALSE)
cen[, dist_to_baseline :=
      sqrt(rowSums((as.matrix(.SD) - matrix(base_vec, .N, length(base_vec),
                                            byrow=TRUE))^2)),
    .SDcols=dist_metrics]
setorder(cen, dist_to_baseline)
data.table::fwrite(cen, file.path(out_dir, "distance_to_baseline.csv"))
cat(sprintf("\n==== MULTIVARIATE DISTANCE TO %s (z-scored: %s) ====\n",
            baseline, paste(dist_metrics, collapse=", ")))
print(cen[, .(condition, dist_to_baseline=round(dist_to_baseline,3))])

