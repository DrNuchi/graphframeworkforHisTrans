## ---- column detection ----------------------------------------------
find_col <- function(nms, patterns){
  for (p in patterns){ h <- grep(p, nms, ignore.case=TRUE, value=TRUE)
  if (length(h)) return(h[1]) }
  stop("No column matching: ", paste(patterns, collapse=" | "))
}

## ---- load one file ---------------------------------------------------------
read_one <- function(f){
  dt  <- data.table::fread(f, sep="\t", showProgress=FALSE)
  nms <- names(dt)
  xc  <- find_col(nms, c("^Centroid.?X","Centroid X"))
  yc  <- find_col(nms, c("^Centroid.?Y","Centroid Y"))
  stem  <- sub("\\.txt$","",basename(f))
  parts <- strsplit(stem,"_")[[1]]
  data.table(
    file=stem, condition=stem_to_condition(paste(parts[-length(parts)],collapse="_")),
    replicate=parts[length(parts)],
    x=as.numeric(dt[[xc]]), y=as.numeric(dt[[yc]])
  )[is.finite(x)&is.finite(y)]
}

