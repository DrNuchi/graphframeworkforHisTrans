# Figure saver
save_fig <- function(filename, plot, ...) {
  path <- file.path(out_dir, "figures", filename)
  ok <- tryCatch({ ggsave(path, plot, ...); TRUE },
                 error = function(e) { message("  [FIG FAILED] ", filename, ": ",
                                               conditionMessage(e)); FALSE })
  if (ok) cat("  saved:", normalizePath(path), "\n")
  invisible(ok)
}

