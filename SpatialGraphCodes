## ---- focused pairwise contrast --------
# report Welch's t (primary, exact for
# small n) plus Cohen's d effect size. 
if (!is.null(PAIR_CONTRAST)) {
  cohens_d <- function(a, b) (mean(b)-mean(a)) /
    sqrt(((length(a)-1)*var(a) + (length(b)-1)*var(b)) / (length(a)+length(b)-2))
  pair_tests <- rbindlist(lapply(metrics, function(m){
    a <- gm[condition==PAIR_CONTRAST[1], get(m)]
    b <- gm[condition==PAIR_CONTRAST[2], get(m)]
    tt <- tryCatch(t.test(a, b), error=function(e) list(p.value=NA))
    data.table(metric=m,
               grp1_mean=mean(a), grp2_mean=mean(b),
               diff=mean(b)-mean(a),
               welch_t_p=tt$p.value,
               cohens_d=tryCatch(cohens_d(a,b), error=function(e) NA))
  }))
  data.table::fwrite(pair_tests, file.path(out_dir, "graph_pairwise_contrast.csv"))
  cat(sprintf("\n==== FOCUSED CONTRAST: %s  vs  %s ====\n",
              PAIR_CONTRAST[1], PAIR_CONTRAST[2]))
  print(pair_tests[, .(metric,
                       g1=round(grp1_mean,3), g2=round(grp2_mean,3),
                       diff=round(diff,3),
                       welch_p=round(welch_t_p,4),
                       cohens_d=round(cohens_d,2))])
}

## ---- density: full significance analysis -----------------------------------
# Density (nuclei/mm²). We report the 5-way omnibus
# AND all pairwise Welch contrasts, on raw and log scale (log stabilises the
# variance, which grows with the mean here).
dens_omni <- data.table(
  scale   = c("raw","log"),
  anova_p = c(summary(aov(density_per_mm2 ~ condition, gm))[[1]][["Pr(>F)"]][1],
              summary(aov(log(density_per_mm2) ~ condition, gm))[[1]][["Pr(>F)"]][1]),
  kruskal_p = c(kruskal.test(density_per_mm2 ~ condition, gm)$p.value,
                kruskal.test(log(density_per_mm2) ~ condition, gm)$p.value))
cat("\n==== DENSITY omnibus (5 groups) ====\n"); print(dens_omni)

pairs_all <- t(combn(levels(gm$condition), 2))
dens_pw <- rbindlist(lapply(seq_len(nrow(pairs_all)), function(i){
  a <- gm[condition==pairs_all[i,1], density_per_mm2]
  b <- gm[condition==pairs_all[i,2], density_per_mm2]
  data.table(
    group1=pairs_all[i,1], group2=pairs_all[i,2],
    mean1=mean(a), mean2=mean(b),
    welch_p_raw = t.test(a,b)$p.value,
    welch_p_log = t.test(log(a),log(b))$p.value)
}))
dens_pw[, `:=`(sig_raw = welch_p_raw < 0.05,
               bonferroni_p_raw = pmin(1, welch_p_raw * .N))]
data.table::fwrite(dens_pw, file.path(out_dir, "density_pairwise_tests.csv"))
cat("\n==== DENSITY pairwise (Welch t) ====\n")
print(dens_pw[, .(group1, group2,
                  mean1=round(mean1), mean2=round(mean2),
                  welch_p_raw=round(welch_p_raw,4),
                  welch_p_log=round(welch_p_log,4),
                  bonferroni_raw=round(bonferroni_p_raw,3),
