## ---- clean mean_degree figure (the headline metric) ------------------------
# Per-image points + condition mean ± SE. mean_degree is the one clearly
# biological graph metric (tracks local nuclear packing), so it gets a
# dedicated figure. graph_density is intentionally NOT shown as a result:
# in radius/kNN graphs it is mechanically mean_degree/(n-1), an n-confound.
deg_summ <- gm[, .(mean = mean(mean_degree),
                   se   = sd(mean_degree)/sqrt(.N)), by = condition]
p_deg <- ggplot() +
  geom_col(data = deg_summ, aes(condition, mean, fill = condition),
           alpha = .35, width = .65) +
  geom_errorbar(data = deg_summ,
                aes(condition, ymin = mean-se, ymax = mean+se), width = .18) +
  geom_jitter(data = gm, aes(condition, mean_degree),
              width = .10, size = 2.4) +
  labs(x = NULL, y = "Mean degree (neighbours)",
       title = "Local nuclear connectivity",
       subtitle = sprintf("%s graph; per-image points, bars = mean ± SE (n = 3)",
                          GRAPH_TYPE)) +
  theme_bw(11) +
  theme(axis.text.x = element_text(angle = 25, hjust = 1),
        legend.position = "none")
save_fig("g0_mean_degree_MAIN.png", p_deg, width = 7.5, height = 5, dpi = 200)

## ---- draw each spatial graph ----------------------------------------------
# Nodes at real coordinates, edges as segments. Big images are dense, so this
# is mainly a visual sanity check of the connectivity structure.
if (PLOT_GRAPHS){
  draw_one <- function(df){
    co <- as.matrix(df[,.(x,y)])
    g  <- build_graph(co)
    el <- igraph::as_edgelist(g)
    edges <- data.table(x=co[el[,1],1], y=co[el[,1],2],
                        xend=co[el[,2],1], yend=co[el[,2],2])
    ggplot() +
      geom_segment(data=edges, aes(x,y,xend=xend,yend=yend),
                   linewidth=0.05, colour="steelblue", alpha=0.4) +
      geom_point(data=df, aes(x,y), size=0.15, colour="black") +
      coord_equal() +
      labs(title=paste0(df$condition[1]," — ",df$file[1]),
           x="X (µm)", y="Y (µm)") + theme_bw(9)
  }
  for (fl in unique(cells$file)){
    p <- draw_one(cells[file==fl])
    save_fig(paste0("graph_",fl,".png"), p, width=6, height=6, dpi=150)
  }
}

